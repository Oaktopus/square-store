# Copy this file to ".env" and fill in your keys from the Square Developer Dashboard
# (developer.squareup.com -> your app -> Credentials)

# "sandbox" to test without real charges, "production" when going live
SQUARE_ENVIRONMENT=sandbox

# Sandbox Access Token (Sandbox tab of your app)
SQUARE_ACCESS_TOKEN=YOUR_ACCESS_TOKEN_HERE

# Sandbox Application ID (starts with "sandbox-sq0idb-...")
SQUARE_APPLICATION_ID=YOUR_APPLICATION_ID_HERE

# Location ID (Locations tab of your app, or "Sandbox Test Account")
SQUARE_LOCATION_ID=YOUR_LOCATION_ID_HERE

# Local server port
PORT=3000
