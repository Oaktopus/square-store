{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "square-store",
  "main": "src/index.js",
  "compatibility_date": "2025-01-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "SQUARE_ENVIRONMENT": "sandbox",
    "SQUARE_APPLICATION_ID": "YOUR_APPLICATION_ID_HERE",
    "SQUARE_LOCATION_ID": "YOUR_LOCATION_ID_HERE"
  }
}
